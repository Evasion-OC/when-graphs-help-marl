# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Results — keep summary CSVs, ignore heavy binaries and ephemeral smoke outputs
results/checkpoints/
results/runs/*.pt
results/smoke/
results/wandb/
results/tensorboard/
*.npz
*.h5

# Logs
logs/
*.log

# Large generated assets
*.mp4
*.gif

# LaTeX build artifacts (keep main.pdf, references.bib, *.tex)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.bcf
paper/*.run.xml

# Run stdout logs
*.out

# Stage A smoke scratch (kept out until results are curated)
results/phaseA_smoke/
results/phaseA_repair/
results/phaseA_goal/
# Stage B raw runs (keep the two small summary CSVs if curated)
results/phaseB/*
!results/phaseB/summary.csv
!results/phaseB/h5_verdict.csv
# Stage C raw runs (keep curated top-level summary CSVs: manifest/summary/verdict)
results/phaseC/*
!results/phaseC/*.csv
# Stage D (token-match) raw runs; its curated CSVs are written under results/phaseC/
results/phaseD/

# Local tooling / third-party template / raw sweep outputs
.codex/
paper/springer_template/
results/phaseC_classical/cell*/
results/phaseD_external/cell*/
scratchpad/
